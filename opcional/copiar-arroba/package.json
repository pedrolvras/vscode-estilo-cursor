{
    "name": "copiar-arroba",
    "displayName": "Copiar com @",
    "description": "Ctrl+C num arquivo do explorador copia @caminho; Ctrl+V no chat do Claude Code vira menção.",
    "version": "1.3.0",
    "publisher": "local",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "configuration": {
            "title": "Copiar com @",
            "properties": {
                "copiarArroba.ativo": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ctrl+C no explorador também põe @caminho na área de transferência."
                }
            }
        },
        "commands": [
            {
                "command": "copiarArroba.alternar",
                "title": "Copiar com @: ligar/desligar"
            },
            {
                "command": "copiarArroba.copiar",
                "title": "Copiar com @: copiar arquivo(s)"
            },
            {
                "command": "copiarArroba.colar",
                "title": "Copiar com @: colar no chat como menção"
            }
        ],
        "keybindings": [
            {
                "command": "copiarArroba.copiar",
                "key": "ctrl+c",
                "mac": "cmd+c",
                "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !inputFocus"
            },
            {
                "command": "copiarArroba.colar",
                "key": "ctrl+v",
                "mac": "cmd+v",
                "when": "config.copiarArroba.ativo && ((activeWebviewPanelId == 'claudeVSCodePanel' && !editorTextFocus && !terminalFocus && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus) || focusedView == 'claudeVSCodeSidebarSecondary' || focusedView == 'claudeVSCodeSidebar')"
            }
        ]
    }
}
